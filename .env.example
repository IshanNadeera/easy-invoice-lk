# Everything prefixed with VITE_ is bundled into the browser code.
# Never put secrets in VITE_ variables.

VITE_APP_NAME=EasyInvoice LK
# Public site URL, shown in the PDF watermark (e.g. https://easyinvoice.lk). Leave empty to omit.
VITE_APP_URL=
# Contact / feedback email shown in the footer and legal pages. Required before public launch.
VITE_CONTACT_EMAIL=fernando.ishannadeera@gmail.com
# Your Facebook profile, linked from your name in the footer (must start with https://).
VITE_AUTHOR_FACEBOOK_URL=
